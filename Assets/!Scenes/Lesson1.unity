  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 60
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 60
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u043C\u0441\u044F \u0432 \u043C\u0438\u0440 \u043F\u0430\u043F\u0438\u0440\u0443\u0441\u043E\u0432, \u0444\u0430\u0440\u0430\u043E\u043D\u043E\u0432 \u0438 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430 \u0438\u043C \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B \u0438 \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0443\u0440\u043E\u0436\u0430\u0439. \u041F\u043E\u0435\u0445\u0430\u043B\u0438!\r\n\r\n***\r\n\r\n### \u041E\u0441\u043D\u043E\u0432\u0430 \u0432\u0441\u0435\u0433\u043E: \u0414\u0440\u0435\u0432\u043D\u0435\u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F, \u0438\u043B\u0438 \u041A\u0430\u043A \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043A\u0430\u043A \u0444\u0430\u0440\u0430\u043E\u043D\r\n\r\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435: \u0436\u0430\u0440\u043A\u0438\u0439 \u0434\u0435\u043D\u044C, \u041D\u0438\u043B \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u0430 \u0432\u0430\u043C, \u0446\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443 \u043F\u0438\u0441\u0446\u0443, \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0448\u043A\u043E\u0432 \u0437\u0435\u0440\u043D\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u043E \u0440\u0430\u0437\u043B\u0438\u0432\u0448\u0435\u0435\u0441\u044F \xAB\u0432\u0435\u043B\u0438\u043A\u043E\u0435 \u043F\u0438\u0442\u044C\u0451\xBB. \u0420\u0438\u043C\u0441\u043A\u0438\u0445 \u0446\u0438\u0444\u0440 \u0435\u0449\u0435 \u043D\u0435\u0442, \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u2014 \u0442\u0435\u043C \u0431\u043E\u043B\u0435\u0435. \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C? \u0414\u0440\u0435\u0432\u043D\u0438\u0435 \u0435\u0433\u0438\u043F\u0442\u044F\u043D\u0435 \u043D\u0430\u0448\u043B\u0438 \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0432\u044B\u0445\u043E\u0434: \u043E\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C.\r\n\r\n\u0418\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F \u0431\u044B\u043B\u0430 **\u043D\u0435\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0434\u0435\u0441\u044F\u0442\u0438\u0447\u043D\u043E\u0439**. \u0417\u0432\u0443\u0447\u0438\u0442 \u0441\u043B\u043E\u0436\u043D\u043E, \u043D\u043E \u043D\u0430 \u0434\u0435\u043B\u0435 \u0432\u0441\u0435 \u043F\u0440\u043E\u0441\u0442\u043E, \u043A\u0430\u043A \u043F\u0430\u043B\u043A\u0430 \u043E \u0434\u0432\u0435 \u043F\u0430\u043B\u043A\u0438.\r\n\r\n**\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0442\u0440\u044F\u0441\u043B\u0438 (\u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439) \u043C\u0438\u0440:**\r\n\r\n1.  **\u0418\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043D\u043E\u0442\u0430\u0446\u0438\u044F:** \u0423 \u043D\u0438\u0445 \u0431\u044B\u043B\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u043D\u0430\u0447\u043A\u0438 (\u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B) \u0434\u043B\u044F \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u0447\u0438\u0441\u0435\u043B. \u0417\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C \u0431\u0430\u0437\u043E\u0432\u044B\u0439 \u043D\u0430\u0431\u043E\u0440:\r\n    * 1 (\u043F\u0430\u043B\u043E\u0447\u043A\u0430)\r\n    * 10 (\u043F\u044F\u0442\u043A\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E \u0441\u043A\u043E\u0442\u0430? \u0414\u0443\u0433\u0430? \u0421\u043F\u043E\u0440\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441!)\r\n    * 100 (\u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044B\u0439 \u043C\u0435\u0440\u043D\u044B\u0439 \u043A\u0430\u043D\u0430\u0442)\r\n    * 1000 (\u0446\u0432\u0435\u0442\u043E\u043A \u043B\u043E\u0442\u043E\u0441\u0430)\r\n    * 10 000 (\u043F\u043E\u0434\u043D\u044F\u0442\u044B\u0439 \u043F\u0430\u043B\u0435\u0446? \u0423\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0430\u043B\u0435\u0446? \u0417\u0430\u0431\u0430\u0432\u043D\u043E, \u0434\u0430?)\r\n    * 100 000 (\u0433\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A! \u0414\u0430-\u0434\u0430, \u0432\u044B \u043D\u0435 \u043E\u0441\u043B\u044B\u0448\u0430\u043B\u0438\u0441\u044C. \u0412\u0438\u0434\u0438\u043C\u043E, \u0438\u0445 \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0432 \u041D\u0438\u043B\u0435).\r\n    * 1 000 000 (\u0443\u043C\u0438\u043B\u0435\u043D\u043D\u044B\u0439 \u0431\u043E\u0436\u043E\u043A \u0441 \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u043C\u0438 \u0440\u0443\u0447\u043A\u0430\u043C\u0438, \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439 \u0442\u0430\u043A\u043E\u0439 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439 \u0446\u0438\u0444\u0440\u043E\u0439).\r\n\r\n    \u0427\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0447\u0438\u0441\u043B\u043E, \u0435\u0433\u0438\u043F\u0442\u044F\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u0430\u043B\u0438 \u044D\u0442\u0438 \u0441\u0438\u043C\u0432\u043E\u043B\u044B. \u0425\u043E\u0447\u0435\u0448\u044C \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C 325? \u0420\u0438\u0441\u0443\u0439 \u0442\u0440\u0438 \u043A\u0430\u043D\u0430\u0442\u0430 (300), \u0434\u0432\u0435 \u043F\u044F\u0442\u043A\u0438 (20) \u0438 \u043F\u044F\u0442\u044C \u043F\u0430\u043B\u043E\u0447\u0435\u043A (5). \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0430, \u0445\u043E\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443 \u0432\u043D\u0438\u0437, \u0445\u043E\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430\u043B\u0435\u0432\u043E. \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.\r\n\r\n2.  **\u0414\u0440\u043E\u0431\u0438 \u2014 \u0432\u0441\u0435\u043C\u0443 \u0433\u043E\u043B\u043E\u0432\u0430:** \u0415\u0433\u0438\u043F\u0442\u044F\u043D\u0435 \u043E\u0431\u043E\u0436\u0430\u043B\u0438 \u0434\u0440\u043E\u0431\u0438, \u043D\u043E \u0441 \u043E\u0434\u043D\u043E\u0439 \u043E\u0433\u043E\u0432\u043E\u0440\u043A\u043E\u0439 \u2014 \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435 \u043E\u043D\u0438 \u0438\u043C\u0435\u043B\u0438 \u0432 \u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u0435 \u0435\u0434\u0438\u043D\u0438\u0446\u0443 (1/2, 1/3, 1/10 \u0438 \u0442.\u0434.). \u0414\u0440\u043E\u0431\u044C 3/4 \u043E\u043D\u0438 \u0431\u044B \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u043A\u0430\u043A \u0441\u0443\u043C\u043C\u0443 1/2 + 1/4. \u041D\u0430\u0439\u0442\u0438 \u044D\u0442\u0438 \u0441\u0443\u043C\u043C\u044B \u0431\u044B\u043B\u043E \u0432\u044B\u0441\u0448\u0438\u043C \u043F\u0438\u043B\u043E\u0442\u0430\u0436\u0435\u043C \u0434\u043B\u044F \u043F\u0438\u0441\u0446\u0430. \u0421\u0430\u043C\u044B\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u2014 **\u043F\u0430\u043F\u0438\u0440\u0443\u0441 \u0410\u0445\u043C\u0435\u0441\u0430** (\u0438\u043B\u0438 \u0420\u0430\u0439\u043D\u0434\u0430) \u2014 \u044D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0437\u0430\u0434\u0430\u0447\u043D\u0438\u043A \u0441 \u0440\u0435\u0448\u0435\u043D\u0438\u044F\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043D\u0430\u043C \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0430\u043A \u043E\u043D\u0438 \u043C\u044B\u0441\u043B\u0438\u043B\u0438.\r\n\r\n**\u041C\u0430\u043B\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0444\u0430\u043A\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0430\u0441 \u0434\u0443\u0448\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043D\u0430 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C\u043D\u043E\u0439 \u0432\u0435\u0447\u0435\u0440\u0438\u043D\u043A\u0435:**\r\n\r\n*   **\u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u043D\u0430 \u043F\u0430\u043F\u0438\u0440\u0443\u0441\u0435:** \u0423 \u0435\u0433\u0438\u043F\u0442\u044F\u043D \u0431\u044B\u043B\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0442\u0430\u0431\u043B\u0438\u0446\u0430 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0434\u0440\u043E\u0431\u0435\u0439 \u0432 \u0441\u0443\u043C\u043C\u0443 \u043F\u0440\u043E\u0441\u0442\u044B\u0445. \u042D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u0435\u0439\u0448\u0430\u044F \u0432 \u043C\u0438\u0440\u0435 \xAB\u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u0430\xBB \u0434\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u043E\u0432.\r\n*   **\u041D\u043E\u043B\u044C? \u041D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0438.** \u041A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438 \u043D\u0443\u043B\u044F \u043A\u0430\u043A \u0447\u0438\u0441\u043B\u0430 \u0443 \u043D\u0438\u0445 \u043D\u0435 \u0431\u044B\u043B\u043E. \u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u0441\u0447\u0435\u0442\u043E\u0432 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432, \u0442\u044B \u0438\u0445 \u0438 \u043D\u0435 \u0440\u0438\u0441\u0443\u0435\u0448\u044C. \u0412\u0441\u0435 \u043B\u043E\u0433\u0438\u0447\u043D\u043E!\r\n*   **\xAB\u0413\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A\u0438\xBB \u0434\u043B\u044F \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432:** \u0422\u043E\u0442 \u0444\u0430\u043A\u0442, \u0447\u0442\u043E \u0434\u043B\u044F \u0441\u0442\u0430 \u0442\u044B\u0441\u044F\u0447 \u043E\u043D\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438 \u0441\u0438\u043C\u0432\u043E\u043B \u0433\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A\u0430, \u0430 \u0434\u043B\u044F \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u0430 \u2014 \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043A\u0430, \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u0431 \u0438\u0445 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u0435 \u044E\u043C\u043E\u0440\u0430 \u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u0413\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A\u043E\u0432 \u0432 \u041D\u0438\u043B\u0435 \u0431\u044B\u043B\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u0435\u0441\u0441\u0447\u0435\u0442\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E!\r\n\r\n---\r\n\r\n#### \u0425\u043E\u0447\u0435\u0448\u044C \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u044D\u0442\u043E \u0432\u0436\u0438\u0432\u0443\u044E? \u0422\u0435\u0431\u0435 \u0432 \u041B\u0443\u043A\u0441\u043E\u0440!\r\n\r\n\u0412\u0435\u043B\u0438\u043A\u0438\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0440\u043E\u0436\u0434\u0430\u044E\u0442\u0441\u044F \u0443 \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u043E\u0432. \u0418 \u043D\u0435\u0442 \u043B\u0443\u0447\u0448\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0433\u0435\u043D\u0438\u044E \u0434\u0440\u0435\u0432\u043D\u0438\u0445, \u0447\u0435\u043C \u041B\u0443\u043A\u0441\u043E\u0440 \u2014 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0439 \u0432 \u043C\u0438\u0440\u0435 \u043C\u0443\u0437\u0435\u0439 \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u043D\u0435\u0431\u043E\u043C.\r\n\r\n\u0417\u0434\u0435\u0441\u044C \u0432\u044B \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u044B \u0438 \u0445\u0440\u0430\u043C\u044B, \u043D\u043E \u0438 \u0432 \u0434\u0435\u0442\u0430\u043B\u044F\u0445 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0437\u0430\u043F\u0438\u0441\u0438.\r\n\r\n*   **\u041B\u0443\u043A\u0441\u043E\u0440\u0441\u043A\u0438\u0439 \u043C\u0443\u0437\u0435\u0439:** \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u044B\u0439. \u0417\u0434\u0435\u0441\u044C \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u044B\u0435 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B, \u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0441\u0442\u0435\u043B \u0438 \u0441\u0442\u0430\u0442\u0443\u0439 \u0441 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438. \u0412\u0433\u043B\u044F\u0434\u0438\u0442\u0435\u0441\u044C \u0432 \u043D\u0438\u0445! \u0421\u0440\u0435\u0434\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A \u0431\u043E\u0433\u043E\u0432 \u0438 \u0444\u0430\u0440\u0430\u043E\u043D\u043E\u0432 \u0432\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u0435 \u0442\u0435 \u0441\u0430\u043C\u044B\u0435 \u043F\u0430\u043B\u043E\u0447\u043A\u0438, \u043A\u0430\u043D\u0430\u0442\u044B \u0438 \u0446\u0432\u0435\u0442\u044B \u043B\u043E\u0442\u043E\u0441\u0430 \u2014 \u0437\u0430\u0441\u0442\u044B\u0432\u0448\u0438\u0435 \u0432 \u043A\u0430\u043C\u043D\u0435 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0440\u0430\u0441\u0447\u0435\u0442\u044B.\r\n\r\n*   **\u041C\u0443\u0437\u0435\u0439 \u043C\u0443\u043C\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438:** \u0417\u0432\u0443\u0447\u0438\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0436\u0443\u0442\u043A\u043E, \u043D\u043E \u044D\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E. \u0415\u0433\u0438\u043F\u0442\u044F\u043D\u0435 \u0431\u044B\u043B\u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u043C\u0438 \u0445\u0438\u043C\u0438\u043A\u0430\u043C\u0438 \u0438 \u0432\u0440\u0430\u0447\u0430\u043C\u0438, \u0430 \u0438\u0445 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u043E \u0444\u0435\u043D\u043E\u043C\u0435\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0441\u0447\u0435\u0442\u043E\u0432 (\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u0438 \u0431\u0430\u043B\u044C\u0437\u0430\u043C\u0438\u0440\u0443\u044E\u0449\u0438\u0445 \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u0432, \u0441\u0440\u043E\u043A\u0438, \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F). \u0417\u0434\u0435\u0441\u044C \u0432\u044B \u043F\u043E\u0439\u043C\u0435\u0442\u0435, \u0447\u0442\u043E \u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0441\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043F\u043E\u0434\u0441\u0447\u0435\u0442\u0430 \u0437\u0435\u0440\u043D\u0430, \u043D\u043E \u0438 \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438.\r\n\r\n---\r\n\r\n\u0412\u043E\u0442 \u0442\u0430\u043A, \u0440\u0438\u0441\u0443\u044F \u043F\u0430\u043B\u043E\u0447\u043A\u0438, \u0433\u043E\u043B\u043E\u0432\u0430\u0441\u0442\u0438\u043A\u043E\u0432 \u0438 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u043D\u044B\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043A\u043E\u0432, \u0435\u0433\u0438\u043F\u0442\u044F\u043D\u0435 \u0437\u0430\u043B\u043E\u0436\u0438\u043B\u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u0440\u0430\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0445 \u043A\u0430\u043C\u043D\u0435\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0438. \u0418\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0431\u044B\u043B\u0430 \u043D\u0435 \u0441\u0430\u043C\u043E\u0439 \u0443\u0434\u043E\u0431\u043D\u043E\u0439 \u0434\u043B\u044F \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u0439, \u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0439 \u0438 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0432 \u0441\u0432\u043E\u0435\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0442\u0435. \u041E\u043D\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0438\u043C\u043F\u0435\u0440\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u043C\u043D\u0438\u0442 \u0441\u0435\u0431\u044F \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F\u043C\u0438.\r\n\r\n\u0422\u0430\u043A \u0447\u0442\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437, \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0438\u043B\u0438 \u0432\u044B\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044F \u0441\u043A\u0438\u0434\u043A\u0443, \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435 \u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u043E\u0433\u043E \u043F\u0438\u0441\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0435\u0440\u0432\u044B\u043C \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0441\u044F \u0441\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u044F\u0442\u044C \u043F\u0430\u043B\u043E\u0447\u0435\u043A \u0432 \u043A\u0443\u0447\u043A\u0443. \u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u0431\u044B \u043D\u0435 \u0431\u044B\u043B\u043E!"
